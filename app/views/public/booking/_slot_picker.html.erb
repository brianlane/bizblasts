<%# Offers only slots from BookingService, the same source as /calendar. %>
<% if @variant_choice_pending %>
  <div class="bg-white rounded-lg shadow border border-gray-200 p-6" data-booking-slot-picker>
    <h2 class="text-lg font-semibold text-gray-900 mb-2">Available times</h2>
    <p class="text-gray-600">Choose an option above to see open times.</p>
  </div>
  <script>
    (function() {
      function bindVariantNavigation() {
        var root = document.getElementById('service_variant_dropdown');
        if (!root || root.dataset.variantNavBound) return;
        root.dataset.variantNavBound = '1';
        root.addEventListener('change', function(event) {
          var select = event.target;
          if (!select || select.name !== 'booking[service_variant_id]' || !select.value) return;
          var url = new URL(window.location.href);
          url.searchParams.set('service_id', '<%= @service.id %>');
          url.searchParams.set('service_variant_id', select.value);
          url.searchParams.delete('date');
          url.searchParams.delete('start_time');
          window.location.assign(url.toString());
        });
      }
      document.addEventListener('turbo:load', bindVariantNavigation);
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', bindVariantNavigation);
      } else {
        bindVariantNavigation();
      }
    })();
  </script>
<% else %>
<% today = @picker_today || Time.current.in_time_zone(business_zone).to_date %>
<% month_label = @picker_date.strftime("%B %Y") %>
<% zone_label = business_zone.to_s %>

<div class="bg-white rounded-lg shadow border border-gray-200" data-booking-slot-picker>
  <div class="p-4 sm:p-6 border-b border-gray-200">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <div>
        <h2 class="text-lg font-semibold text-gray-900">Available times</h2>
        <p class="text-sm text-gray-500 mt-1">Times shown in <%= zone_label %>. Only open appointments can be selected.</p>
      </div>
      <div class="flex items-center justify-center gap-2" role="group" aria-label="Choose month">
        <%= link_to new_tenant_booking_path(picker_query(@picker_date.prev_month.beginning_of_month)),
              class: "inline-flex items-center justify-center px-3 py-2 bg-gray-200 rounded hover:bg-gray-300 min-w-[44px] min-h-[44px]",
              aria: { label: "Previous month" } do %>
          <span aria-hidden="true">&larr;</span>
          <span class="hidden sm:inline ml-1">Previous</span>
        <% end %>
        <span class="px-2 font-medium text-sm sm:text-base"><%= month_label %></span>
        <%= link_to new_tenant_booking_path(picker_query(@picker_date.next_month.beginning_of_month)),
              class: "inline-flex items-center justify-center px-3 py-2 bg-gray-200 rounded hover:bg-gray-300 min-w-[44px] min-h-[44px]",
              aria: { label: "Next month" } do %>
          <span class="hidden sm:inline mr-1">Next</span>
          <span aria-hidden="true">&rarr;</span>
        <% end %>
      </div>
    </div>
  </div>

  <% if @calendar_start_date && @calendar_end_date %>
    <div class="sm:hidden divide-y divide-gray-200" role="list" aria-label="Days with availability">
      <% (@calendar_start_date..@calendar_end_date).each do |date| %>
        <% next if date < today || date.month != @picker_date.month %>
        <% count = day_slots_for(date).length %>
        <% if count.positive? %>
          <%= link_to new_tenant_booking_path(picker_query(date)),
                class: "flex items-center justify-between p-4 hover:bg-gray-50 min-h-[48px] #{'bg-blue-50' if date == @picker_date}",
                aria: { current: (date == @picker_date ? 'date' : nil) } do %>
            <span>
              <span class="block font-medium text-gray-900"><%= date.strftime("%A") %></span>
              <span class="block text-sm text-gray-500"><%= date.strftime("%B %-d, %Y") %></span>
            </span>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800" data-slot-count="<%= count %>">
              <%= pluralize(count, 'slot') %>
            </span>
          <% end %>
        <% else %>
          <div class="flex items-center justify-between p-4 text-gray-400" aria-disabled="true" data-slot-count="0">
            <span>
              <span class="block font-medium"><%= date.strftime("%A") %></span>
              <span class="block text-sm"><%= date.strftime("%B %-d") %></span>
            </span>
            <span class="text-xs">No openings</span>
          </div>
        <% end %>
      <% end %>
    </div>

    <div class="hidden sm:block p-4 sm:p-6">
      <div class="grid grid-cols-7 gap-1 text-center text-xs font-medium text-gray-500 mb-2" aria-hidden="true">
        <% %w[Mon Tue Wed Thu Fri Sat Sun].each do |day_name| %>
          <div class="py-1"><%= day_name %></div>
        <% end %>
      </div>
      <div class="grid grid-cols-7 gap-1" role="grid" aria-label="<%= month_label %>">
        <% (@calendar_start_date..@calendar_end_date).each do |date| %>
          <% count = day_slots_for(date).length %>
          <% past = date < today %>
          <% outside = date.month != @picker_date.month %>
          <% open = !past && !outside && count.positive? %>
          <div role="gridcell" class="min-h-[72px]">
            <% if open %>
              <%= link_to new_tenant_booking_path(picker_query(date)),
                    class: "flex flex-col items-center justify-center h-full rounded-md border text-sm hover:border-blue-400 #{date == @picker_date ? 'border-blue-600 bg-blue-50 ring-2 ring-blue-600' : 'border-gray-200'}",
                    aria: { label: "#{date.strftime('%B %-d')}, #{pluralize(count, 'opening')}", current: (date == @picker_date ? 'date' : nil) } do %>
                <span class="font-medium text-gray-900"><%= date.day %></span>
                <span class="mt-1 inline-flex items-center justify-center min-w-[1.5rem] px-1.5 py-0.5 rounded-full text-xs font-medium text-white" style="background-color: #4caf50;" data-slot-count="<%= count %>"><%= count %></span>
              <% end %>
            <% else %>
              <div class="flex flex-col items-center justify-center h-full rounded-md text-sm text-gray-300 <%= 'bg-gray-50' if past %>" aria-disabled="true" data-slot-count="<%= past || outside ? 0 : count %>">
                <span><%= date.day %></span>
                <% if !past && !outside %>
                  <span class="mt-1 inline-flex items-center justify-center min-w-[1.5rem] px-1.5 py-0.5 rounded-full text-xs text-white" style="background-color: #999999;">0</span>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <fieldset class="p-4 sm:p-6 border-t border-gray-200">
    <legend class="text-base font-semibold text-gray-900 mb-3">
      <% if @picker_date %>
        <%= @picker_date.strftime("%A, %B %-d, %Y") %>
      <% else %>
        Choose a day
      <% end %>
    </legend>

    <% slots = Array(@day_slots) %>
    <% if slots.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" role="radiogroup" aria-label="Open appointment times">
        <% slots.each do |slot| %>
          <% start_at = parse_slot_time(slot[:start_time] || slot['start_time']) %>
          <% next unless start_at %>
          <% local = start_at.in_time_zone(business_zone) %>
          <% staff_id = slot[:staff_member_id] || slot['staff_member_id'] %>
          <% staff_name = slot[:staff_member_name] || slot['staff_member_name'] %>
          <label class="block border rounded-lg overflow-hidden cursor-pointer focus-within:ring-2 focus-within:ring-blue-600">
            <input type="radio"
                   name="booking[slot_choice]"
                   value="<%= "#{start_at.iso8601}|#{staff_id}" %>"
                   class="sr-only peer"
                   required
                   aria-label="<%= "#{local.strftime('%-l:%M %p')}#{staff_name.present? ? " with #{staff_name}" : ""}" %>">
            <span class="flex justify-between items-center p-4 bg-green-50 peer-checked:bg-green-100">
              <span>
                <span class="block text-base sm:text-lg font-medium text-gray-900"><%= local.strftime("%-l:%M %p") %></span>
                <% if staff_name.present? %>
                  <span class="block text-xs text-gray-600 mt-1">Staff: <%= staff_name %></span>
                <% end %>
              </span>
              <span class="font-medium px-2 py-1 rounded text-xs bg-green-600 text-white">Available</span>
            </span>
            <span class="block w-full bg-blue-600 peer-checked:bg-blue-800 text-white font-medium py-3 text-center">Select this time</span>
          </label>
        <% end %>
      </div>
    <% else %>
      <p class="text-gray-600 bg-gray-50 rounded-lg p-6 text-center">No open times on this day. Choose a day with a green count.</p>
    <% end %>
  </fieldset>
</div>
<% end %>
