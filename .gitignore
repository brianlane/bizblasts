# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
# Both rules are needed: `/.env*` is root-anchored, so on its own a stray
# config/.env or app/.env would be committable. These files hold real
# credentials -- .env.example in this repo carries a live database password
# and SECRET_KEY_BASE despite the "example" name -- so the unanchored rule
# is the backstop that keeps any of them from reaching the remote.
/.env*
.env
.env.*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/test.out
/test.log

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore master key for decrypting credentials and more.
/config/master.key

# Ignore node modules
/node_modules

# Ignore yarn files
/yarn-error.log
yarn-debug.log*
.yarn-integrity

# Ignore coverage reports
/coverage/*
!/coverage/.last_run.json

# Ignore public uploads
/public/uploads

/config/credentials/production.key

/app/assets/builds/*
!/app/assets/builds/.keep

# Ignore test output files
test.out
test.log

# Ignore coverage files
coverage/.last_run.json
/config/credentials/development.key

coverage/
